    if (!isAuthReady || !currentUserId) { /* ... handle not ready ... */ return; }
    const strategyDocRef = doc(db, `artifacts/<span class="math-inline">\{appId\}/users/</span>{currentUserId}/user_strategies`, 'my_strategy');
